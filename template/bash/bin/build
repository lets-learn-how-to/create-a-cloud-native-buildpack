#!/usr/bin/env bash

source "$CNB_BUILDPACK_DIR/bin/buildpack.sh"

# Create a new layer with build, launch and cache turned on
create_layer "primes" true true true

if [[ "$(read_plan_metadata max_prime)" == "$(read_layer_metadata primes max_prime)" ]]; then
  log_topic "Reusing cached layer"
  log_topic_info "Last time we found $(cat "$CNB_LAYERS_DIR/primes/env/PRIMES.default" | wc -w | tr -d ' ') Primes"
  # Exit with success
  # See the exit code spec at: https://buildpacks.io/docs/for-platform-operators/concepts/lifecycle/build/#exit-codes
  exit 0
fi

log_topic "Generating primes up to $BP_TEMPLATE_BASH_MAX_PRIME"

PRIMES="$(bash "$CNB_BUILDPACK_DIR/bin/calculate_primes.sh" "$BP_TEMPLATE_BASH_MAX_PRIME")"

log_topic_info "Found $(echo "$PRIMES" | wc -w | tr -d ' ') Primes"

export_env_var "primes" "PRIMES" "$PRIMES" "default"

write_layer_metadata "primes"

# Exit with success
# See the exit code spec at: https://buildpacks.io/docs/for-platform-operators/concepts/lifecycle/build/#exit-codes
exit 0
