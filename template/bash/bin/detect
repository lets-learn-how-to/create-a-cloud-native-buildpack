#!/usr/bin/env bash

source "$CNB_BUILDPACK_DIR/bin/buildpack.sh"

# Create a build plan that provides and
# requires primes, with some metadata
create_plan "primes" "primes" <<-METADATA
  max_prime = "$BP_TEMPLATE_BASH_MAX_PRIME"
METADATA

# Exit with success
# See the exit code spec at: https://buildpacks.io/docs/for-platform-operators/concepts/lifecycle/detect/#exit-codes
exit 0
